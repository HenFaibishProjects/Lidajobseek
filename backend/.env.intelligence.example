# Additive Company Intelligence configuration.
# Keep the existing Reqcue DATABASE_URL/JWT/etc. configuration unchanged.

INTELLIGENCE_DB_HOST=
INTELLIGENCE_DB_PORT=5432
INTELLIGENCE_DB_USERNAME=
INTELLIGENCE_DB_PASSWORD=
INTELLIGENCE_DB_DATABASE=
# Lowercase PostgreSQL identifier. Raw migrations and TypeORM entities use this same schema.
INTELLIGENCE_DB_SCHEMA=public
INTELLIGENCE_DB_SSL=true

# Only this authenticated Reqcue user may access /api/intelligence/*.
INTELLIGENCE_ALLOWED_EMAIL=

# Keep disabled while the old job-agent-details service is still polling Gmail.
RECRUITER_GMAIL_POLLING_ENABLED=false

# Required only when RECRUITER_GMAIL_POLLING_ENABLED=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

TAVILY_API_KEY=
FIRECRAWL_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

RECRUITER_DECISION_PROVIDER=openai
RECRUITER_DECISION_MODEL=gpt-6-luna
RECRUITER_CHEAP_PROVIDER=openai
RECRUITER_CHEAP_MODEL=gpt-6-luna
RECRUITER_ANALYSIS_PROVIDER=openai
RECRUITER_ANALYSIS_MODEL=gpt-6.1-terra
RECRUITER_RESEARCH_PROVIDER=deepseek
RECRUITER_RESEARCH_MODEL=deepseek-flash

RECRUITER_NOTIFICATION_TO=
RECRUITER_NOTIFICATION_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
APP_BASE_URL=
